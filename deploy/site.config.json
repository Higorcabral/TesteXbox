{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    { "route": "/scripts/*", "statusCode": 404 },
    { "route": "/deploy/*",  "statusCode": 404 },
    { "route": "/modulos/*", "statusCode": 404 },
    { "route": "/portal/*",  "statusCode": 404 },

    { "route": "/projetos/Projeto-CRM",   "redirect": "/projetos/crm/",      "statusCode": 301 },
    { "route": "/projetos/Projeto-CRM/*", "redirect": "/projetos/crm/",      "statusCode": 301 },
    { "route": "/projetos/Projeto-Mani",  "redirect": "/projetos/manicure/", "statusCode": 301 },
    { "route": "/projetos/Projeto-Mani/*","redirect": "/projetos/manicure/", "statusCode": 301 },
    { "route": "/projetos/Projeto-Mecan", "redirect": "/projetos/mecanica/", "statusCode": 301 },
    { "route": "/projetos/Projeto-Mecan/*","redirect": "/projetos/mecanica/","statusCode": 301 },
    { "route": "/projetos/Projeto-Stoq",  "redirect": "/projetos/estoque/",  "statusCode": 301 },
    { "route": "/projetos/Projeto-Stoq/*","redirect": "/projetos/estoque/",  "statusCode": 301 },

    { "route": "/vendor/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*", "headers": { "cache-control": "public, max-age=604800" } },
    { "route": "/js/*",     "headers": { "cache-control": "public, max-age=86400" } },
    { "route": "/blog/*",   "headers": { "cache-control": "public, max-age=3600" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".webp": "image/webp",
    ".svg": "image/svg+xml",
    ".css": "text/css",
    ".js":  "application/javascript",
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
